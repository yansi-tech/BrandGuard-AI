<%- include('partials/top') %>
<section class="page-heading compact"><div><p class="eyebrow">BRAND KNOWLEDGE HUB</p><h1>Your source of brand truth.</h1><p>These approved rules give every review its context. Updates are saved to MySQL immediately.</p></div><button class="button primary" data-modal-open="rule-modal">+ Add rule</button></section>
<section class="knowledge-grid">
  <% ['guideline', 'preferred', 'prohibited', 'fact'].forEach((type) => { const items = brandRules.filter(r => r.rule_type === type); const names = { guideline: 'Guidelines', preferred: 'Preferred language', prohibited: 'Prohibited language', fact: 'Approved facts' }; %>
  <article class="panel rule-group"><div class="panel-title"><div><p class="rule-type <%= type %>"><%= type %></p><h2><%= names[type] %></h2></div><span class="rule-count"><%= items.length %></span></div><% if (items.length) { %><div class="rules"><% items.forEach((rule) => { %><div class="rule"><div><strong><%= rule.title %></strong><p><%= rule.content %></p></div><button class="delete-rule" data-rule-id="<%= rule.id %>" aria-label="Delete <%= rule.title %>">×</button></div><% }) %></div><% } else { %><p class="muted">No entries yet.</p><% } %></article><% }) %>
</section>
<div class="modal-backdrop" id="rule-modal" hidden><form id="rule-form" class="modal"><button type="button" class="modal-close" data-modal-close>×</button><p class="eyebrow">ADD BRAND RULE</p><h2>Teach BrandGuard</h2><label for="ruleType">Rule type</label><select id="ruleType" name="ruleType"><% ruleTypes.forEach((type) => { %><option value="<%= type %>"><%= type %></option><% }) %></select><label for="ruleTitle">Rule title</label><input id="ruleTitle" name="title" maxlength="160" required placeholder="e.g. Product naming convention"><label for="ruleContent">Rule or approved text</label><textarea id="ruleContent" name="content" maxlength="5000" required placeholder="Describe the guidance, term, or verified fact."></textarea><button class="button primary" type="submit">Save rule</button></form></div>
<%- include('partials/bottom') %>
