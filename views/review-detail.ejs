<%- include('partials/top') %>
<section class="detail-heading"><div><a class="back-link" href="/">← Overview</a><p class="eyebrow"><%= review.content_type.toUpperCase() %> · REVIEW REPORT</p><h1><%= review.title %></h1><p>Created <%= new Date(review.created_at).toLocaleString() %></p></div><span class="status large-status <%= review.status.toLowerCase().replace('_', '-') %>"><%= review.status.replace('_', ' ') %></span></section>
<% const currentContent = review.revised_content || review.original_content; const accepted = issues.filter(i => i.decision === 'ACCEPTED').length; %>
<section class="compliance-banner <%= summary.score >= 80 ? 'good' : summary.score >= 60 ? 'watch' : 'risk' %>"><div class="compliance-score"><strong><%= summary.score %></strong><span>/100</span></div><div><p class="eyebrow">TRANSPARENT COMPLIANCE SCORE</p><h2><%= summary.score >= 80 ? 'Ready for a human review' : summary.score >= 60 ? 'Needs a careful pass' : 'Address key issues first' %></h2><p>Starts at 100 and deducts <%= summary.weights.critical %>/<%= summary.weights.high %>/<%= summary.weights.medium %>/<%= summary.weights.low %> points per critical, high, medium or low finding. It is not a guarantee of compliance.</p></div><div class="score-summary"><strong><%= issues.length %></strong><span>findings</span><strong><%= accepted %></strong><span>suggestions accepted</span></div></section>
<section class="report-layout">
  <div class="report-main">
    <article class="panel"><div class="panel-title"><div><h2>Detected issues</h2><p><%= review.analysis_mode === 'gemini' ? 'Gemini-assisted analysis plus deterministic rule checks.' : 'Deterministic checks against saved brand rules.' %> Findings need human judgment.</p></div></div>
      <% if (issues.length) { %><div class="finding-list"><% issues.forEach((issue, index) => { %><article class="finding <%= issue.severity %>" data-issue-id="<%= issue.id %>"><div class="finding-top"><span class="severity <%= issue.severity %>"><%= issue.severity %></span><span class="finding-category"><%= issue.category %></span><span class="decision-tag <%= issue.decision.toLowerCase() %>"><%= issue.decision %></span></div><blockquote>“<%= issue.problematic_text %>”</blockquote><p><%= issue.explanation %></p><div class="source"><span>↗</span><div><small>SUPPORTING RULE / SOURCE</small><strong><%= issue.supporting_source %></strong></div></div><div class="correction"><small>SUGGESTED CORRECTION</small><p><%= issue.suggested_correction %></p></div><div class="finding-actions"><button class="button small secondary apply-suggestion" data-issue-id="<%= issue.id %>" <%= issue.decision === 'REJECTED' ? 'disabled' : '' %>>Apply correction</button><button class="text-button decide-issue" data-decision="ACCEPTED" data-issue-id="<%= issue.id %>">Accept</button><button class="text-button decide-issue" data-decision="REJECTED" data-issue-id="<%= issue.id %>">Reject</button></div></article><% }) %></div><% } else { %><div class="empty-state compact-empty"><span>✓</span><h3>No issues were detected</h3><p>This is not a final approval; a human reviewer should still validate the content and facts.</p></div><% } %>
    </article>
    <article class="panel revised-panel"><div class="panel-title"><div><h2>Revised content</h2><p>Apply a suggested correction or edit directly before submitting.</p></div></div><textarea id="revised-content" rows="12" maxlength="30000"><%= currentContent %></textarea><div class="submit-row"><input id="revision-note" maxlength="500" placeholder="Optional note for the reviewer"><button class="button primary" id="submit-review" data-review-id="<%= review.id %>">Submit for review →</button></div></article>
  </div>
  <aside class="report-side">
    <article class="panel approval-panel"><p class="eyebrow">HUMAN APPROVAL</p><h2>Final decision stays with your team.</h2><p>Approval never happens automatically, regardless of score.</p><textarea id="reviewer-comment" rows="4" maxlength="2000" placeholder="Add context or a revision request…"></textarea><div class="approval-actions"><button class="button approve reviewer-action" data-action="APPROVE" data-review-id="<%= review.id %>">✓ Approve</button><button class="button request reviewer-action" data-action="REQUEST_REVISION" data-review-id="<%= review.id %>">Request revision</button></div></article>
    <article class="panel comments-panel"><div class="panel-title"><div><h2>Review comments</h2><p>Conversation stays with the review.</p></div></div><div id="comment-list"><% if (comments.length) { comments.forEach((comment) => { %><div class="comment"><span class="avatar small-avatar"><%= comment.author_name.slice(0, 2).toUpperCase() %></span><div><strong><%= comment.author_name %></strong><time><%= new Date(comment.created_at).toLocaleString() %></time><p><%= comment.comment_text %></p></div></div><% }) } else { %><p class="muted">No comments yet.</p><% } %></div><div class="add-comment"><input id="new-comment" maxlength="2000" placeholder="Add a comment"><button class="button small secondary" id="add-comment" data-review-id="<%= review.id %>">Post</button></div></article>
    <article class="panel history-panel"><div class="panel-title"><div><h2>Revision history</h2><p><%= revisions.length %> saved version<%= revisions.length === 1 ? '' : 's' %></p></div></div><% revisions.forEach((revision, index) => { %><div class="history-item"><span></span><div><strong>Version <%= revisions.length - index %></strong><p><%= revision.note || 'Saved revision' %></p><time><%= new Date(revision.created_at).toLocaleString() %></time></div></div><% }) %></article>
  </aside>
</section>
<%- include('partials/bottom') %>
