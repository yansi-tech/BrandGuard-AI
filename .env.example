# Web server
PORT=3000
NODE_ENV=development

# MySQL (create this database before running npm run db:init)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=brandguard_ai

# Gemini. Leave blank to use the deterministic local rule engine only.
# This value is only read by the server; never put it in client-side JavaScript.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
